# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/prime
# Max connections this instance opens to Postgres. Keep (instances * PG_POOL_MAX) under
# the Postgres plan's connection limit.
PG_POOL_MAX=20
# Only needed if DATABASE_URL is reachable over the public internet (not Render's private
# network) and you want full certificate validation instead of the default relaxed TLS.
# PGSSL_REJECT_UNAUTHORIZED=true
# PGSSL_CA=

# JWT — required in production, must be a random value >= 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-in-production

# CORS — comma-separated list of allowed frontend origins. Required in production.
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Email delivery (pick one). Without these, emails log to console and PDFs save under uploads/emails/
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=admissions@yourschool.edu.et

# Or Resend:
# RESEND_API_KEY=re_xxx
# EMAIL_FROM=Admissions <admissions@yourschool.edu.et>
PORT=3004
NODE_ENV=development
PG_USER_NAME=postgres
PG_PASSWORD=prime123
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=Prime
